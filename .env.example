# Local preview only; these flags are not access controls or media clearance.
ENABLE_HOMEPAGE_PREVIEW=true
ENABLE_FOUNDATION_PREVIEW=false
ENABLE_SITE_PREVIEW=true
# Keep false on previews. Enable only for an approved release, at build AND runtime.
SITE_INDEXABLE=false
SITE_URL=https://www.pocketcreatives.co.uk
# Enquiries remain unavailable until every setting is configured.
CONTACT_ENABLED=false
CONTACT_TO=team@pocketcreatives.co.uk
# Verified sender on a domain you control, e.g. Pocket Creatives <enquiries@example.com>
CONTACT_FROM=
RESEND_API_KEY=
# Generate a strong random value; keep server-side. Never use NEXT_PUBLIC_ for secrets.
CONTACT_FORM_SECRET=
# Exact origin of the contact page (update for the deployment).
CONTACT_ALLOWED_ORIGIN=http://127.0.0.1:3005

# Enable only with the migration release; leaves legacy sectors and journal archive untouched.
ENABLE_LEGACY_REDIRECTS=false
