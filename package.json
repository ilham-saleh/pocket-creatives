{
  "name": "pocket-creatives",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || >=26.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src scripts next.config.ts vite.config.ts cloudflare.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "fonts:setup": "node scripts/setup-fonts.mjs",
    "media:setup": "node scripts/setup-home-media.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "typecheck:cloudflare": "tsc --project tsconfig.cloudflare.json --noEmit"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@vinext/cloudflare": "^1.3.3",
    "geist": "1.9.1",
    "gsap": "3.15.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.39",
    "axe-core": "4.14.0",
    "cf": "^1.0.0-beta.28",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.7.5"
  }
